  eventId   String
  mediaUrl  String
  caption   String?
  mediaType String   @default("IMAGE") // IMAGE, VIDEO
  createdAt DateTime @default(now())

  event SchoolEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

