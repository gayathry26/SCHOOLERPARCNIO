generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// INSTITUTION & MULTI-CAMPUS
// -------------------------------------------------------------

model School {
  id                  String   @id @default(cuid())
  tenantCode          String   @unique @default("MAIN")
  name                String   @default("Edvonest Model International Academy")
  affiliationNo       String   @default("CBSE/AFF/2026/89410")
  board               String   @default("CBSE")
  email               String   @default("contact@edvonest-academy.edu.in")
  phone               String   @default("+91 11 4982 3000")
  address             String   @default("Plot 12, Institutional Area, Sector 62")
  city                String   @default("Noida")
  state               String   @default("Uttar Pradesh")
  pincode             String   @default("201309")
  currencySymbol      String   @default("₹")
  currencyCode        String   @default("INR")
  attendanceThreshold Float    @default(75.0)

  // SaaS Multi-Tenant Fields
  logoUrl             String?
  themeColor          String?  @default("#086A92")
  domain              String?
  status              String   @default("ACTIVE") // ACTIVE, PENDING_APPROVAL, SUSPENDED, TRIAL_EXPIRED
  subscriptionPlan    String   @default("PREMIUM") // FREE_TRIAL, BASIC, STANDARD, PREMIUM, ENTERPRISE
  subscriptionStatus  String   @default("ACTIVE") // ACTIVE, TRIAL, PAST_DUE, CANCELLED
  trialEndsAt         DateTime?
  subscriptionRenewsAt DateTime?
  maxStudents         Int      @default(2000)
  maxStaff            Int      @default(200)
  enabledModules      String?  @default("ALL")
  onboardingStatus    String   @default("COMPLETED") // PENDING, PROFILE_SETUP, ACADEMICS_CONFIGURED, COMPLETED
  contactPersonName   String?
  contactPersonEmail  String?
  contactPersonPhone  String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users                User[]
  announcements        Announcement[]
  auditLogs            AuditLog[]
  events               SchoolEvent[]
  cmsPages             CmsPage[]
  branches             CampusBranch[]
  academicYears        AcademicYear[]
  classes              Class[]
  feeStructures        FeeStructure[]
  subscriptionInvoices SubscriptionInvoice[]
}

model CampusBranch {
  id              String   @id @default(cuid())
  schoolId        String
  name            String
  branchCode      String   @unique
  address         String
  city            String
  state           String
  principalName   String
  contactPhone    String
  studentCapacity Int      @default(1500)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// CORE AUTHENTICATION & USERS
// -------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  role         String   @default("STUDENT")
  firstName    String
  lastName     String
  phone        String?
  avatarUrl    String?
  isActive     Boolean  @default(true)
  schoolId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school           School?          @relation(fields: [schoolId], references: [id])
  studentProfile   StudentProfile?
  teacherProfile   TeacherProfile?
  parentProfile    ParentProfile?
  staffProfile     StaffProfile?
  auditLogs        AuditLog[]
  sentMessages     DirectMessage[]  @relation("SentMessages")
  receivedMessages DirectMessage[]  @relation("ReceivedMessages")
  notifications    Notification[]

  // Safety & Asset Relations
  gateLogs         GateLog[]
  safetyIncidents  SafetyIncident[]
  assetIssues      AssetIssueRecord[]
  purchaseRequests PurchaseRequest[]
}

// -------------------------------------------------------------
// ACADEMIC STRUCTURE (ACADEMIC YEAR, CLASS, SECTION, SUBJECT)
// -------------------------------------------------------------

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String?  @default("edvonest-main-school")
  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  status    String   @default("ACTIVE") // UPCOMING, ACTIVE, CLOSED, ARCHIVED
  isLocked  Boolean  @default(false)
  closedAt  DateTime?
  closedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school            School?             @relation(fields: [schoolId], references: [id])
  classes           Class[]
  enrollments       StudentEnrollment[]
  attendanceRecords AttendanceRecord[]
  timetableEntries  TimetableEntry[]
  feeStructures     FeeStructure[]
  exams             Exam[]
  teacherAllocations TeacherAllocation[]
  promotionsFrom    StudentPromotionLog[] @relation("FromYear")
  promotionsTo      StudentPromotionLog[] @relation("ToYear")
  closingLogs       YearEndClosingLog[]
}

model Class {
  id             String   @id @default(cuid())
  schoolId       String?  @default("edvonest-main-school")
  name           String
  numericOrder   Int      @default(1)
  stream         String?  @default("General")
  academicYearId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school        School?             @relation(fields: [schoolId], references: [id])
  academicYear  AcademicYear?       @relation(fields: [academicYearId], references: [id])
  sections      Section[]
  subjects      Subject[]
  enrollments   StudentEnrollment[]
  homeworks     Homework[]
  feeStructures FeeStructure[]

  // New modules
  lessonPlans    LessonPlan[]
  questionPapers QuestionPaper[]
  mockTests      MockTest[]
  teacherAllocations TeacherAllocation[]
  promotionsFrom StudentPromotionLog[] @relation("FromClass")
  promotionsTo   StudentPromotionLog[] @relation("ToClass")
}

model Section {
  id             String   @id @default(cuid())
  name           String
  roomNo         String?  @default("Room 101")
  classId        String
  classTeacherId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  class             Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  classTeacher      TeacherProfile?      @relation(fields: [classTeacherId], references: [id])
  enrollments       StudentEnrollment[]
  attendanceRecords AttendanceRecord[]
  timetableEntries  TimetableEntry[]
  homeworks         Homework[]

  // New modules
  lessonPlans       LessonPlan[]
  substituteSlots   SubstituteAssignment[]
  teacherAllocations TeacherAllocation[]
}

model Subject {
  id        String   @id @default(cuid())
  name      String
  code      String?
  classId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class            Class?            @relation(fields: [classId], references: [id])
  teacherSubjects  TeacherSubject[]
  studyMaterials   StudyMaterial[]
  timetableEntries TimetableEntry[]
  homeworks        Homework[]
  examSchedules    ExamSchedule[]
  teacherAllocations TeacherAllocation[]

  // Module A, B, C, D
  chapters         Chapter[]
  lessonPlans      LessonPlan[]
  questions        Question[]
  questionPapers   QuestionPaper[]
  mockTests        MockTest[]
  learningPaths    LearningPath[]
  revisionSchedules RevisionSchedule[]
}

model Chapter {
  id            String   @id @default(cuid())
  subjectId     String
  name          String
  chapterNumber Int      @default(1)
  totalPeriods  Int      @default(6)
  isCompleted   Boolean  @default(false)
  completedAt   DateTime?
  createdAt     DateTime @default(now())

  subject     Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lessonPlans LessonPlan[]
  questions   Question[]
}

model TeacherSubject {
  id        String @id @default(cuid())
  teacherId String
  subjectId String

  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// STUDENT & PARENT PROFILES
// -------------------------------------------------------------

model StudentProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  admissionNumber  String   @unique
  rollNumber       String?
  dob              DateTime
  gender           String
  bloodGroup       String?  @default("O+")
  address          String?
  city             String?  @default("Noida")
  state            String?  @default("Uttar Pradesh")
  pincode          String?  @default("201301")
  emergencyContact String?
  house            String?  @default("Emerald")
  admissionDate    DateTime @default(now())
  previousSchool   String?
  isArchived       Boolean  @default(false)
  archivedReason   String?
  lifecycleStage   String   @default("ACTIVE_ENROLLMENT") // ENQUIRY, APPLICATION, ADMISSION, ACTIVE_ENROLLMENT, PROMOTED, DETAINED, TC_ISSUED, ALUMNI
  tcNumber         String?
  tcDate           DateTime?
  leavingReason    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user            User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments     StudentEnrollment[]
  parents         StudentParentMap[]
  attendance      AttendanceRecord[]
  invoices        StudentFeeInvoice[]
  markEntries     ExamMarkEntry[]
  submissions     HomeworkSubmission[]
  transportAssign StudentTransportAssignment?
  libraryIssues   BookIssueRecord[]
  certificates    IssuedCertificate[]

  // Next-Gen Upgrades
  academicAlerts     AcademicAlert[]
  healthProfile      StudentHealthProfile?
  clinicVisits       ClinicVisit[]
  achievements       StudentAchievement[]
  authorizedPickups  AuthorizedPickup[]
  digitalConsents    DigitalConsent[]
  eventRegistrations EventRegistration[]
  learningPaths      LearningPath[]
  revisionSchedules  RevisionSchedule[]
  mockSubmissions    MockTestSubmission[]
  promotionLogs      StudentPromotionLog[]
  sectionTransfers   SectionTransferLog[]
  alumniRecord       AlumniRecord?
  concessions        StudentFeeConcession[]
  feeReminders       FeeReminderLog[]
  ptmBookings        PtmBooking[]
}

model TeacherProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  employeeCode   String   @unique
  specialization String?  @default("Mathematics")
  qualification  String?  @default("M.Sc, B.Ed")
  designation    String   @default("Senior Faculty")
  status         String   @default("ACTIVE") // ACTIVE, ON_LEAVE, TRANSFERRED, RESIGNED, RETIRED, TERMINATED, ARCHIVED
  departmentId   String?
  basicSalary    Float    @default(45000)
  joiningDate    DateTime @default(now())
  resignationDate DateTime?
  retirementDate  DateTime?
  terminationDate DateTime?
  rejoiningDate   DateTime?
  exitReason      String?
  lifecycleNotes  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  department       Department?        @relation("TeacherDepartment", fields: [departmentId], references: [id])
  sections         Section[]
  teacherSubjects  TeacherSubject[]
  timetableEntries TimetableEntry[]
  leaveRequests    LeaveRequest[]
  salarySlips      StaffSalarySlip[]

  // Upgrades
  lessonPlans        LessonPlan[]
  substituteFor      SubstituteAssignment[] @relation("AbsentTeacher")
  substituteTo       SubstituteAssignment[] @relation("SubTeacher")
  attendanceRecords  StaffAttendanceRecord[]
  appraisals         StaffAppraisal[]
  ptmBookings        PtmBooking[]
  teacherAllocations TeacherAllocation[]
  salaryHistory      StaffSalaryHistory[]
  lifecycleLogs      StaffLifecycleLog[]
  ptmSlots           PtmSlot[]
}

model ParentProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  relation   String?  @default("Father")
  occupation String?  @default("Professional")
  phone      String?
  address    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  students        StudentParentMap[]
  ptmBookings     PtmBooking[]
  digitalConsents DigitalConsent[]
}

model StudentParentMap {
  id        String  @id @default(cuid())
  studentId String
  parentId  String
  isPrimary Boolean @default(true)

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  ParentProfile  @relation(fields: [parentId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// STAFF & DEPARTMENTS
// -------------------------------------------------------------

model Department {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  staffProfiles StaffProfile[]
  teachers      TeacherProfile[] @relation("TeacherDepartment")
  assets        AssetItem[]
}

model StaffProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  employeeCode    String    @unique
  designation     String    @default("Staff")
  status          String    @default("ACTIVE") // ACTIVE, ON_LEAVE, TRANSFERRED, RESIGNED, RETIRED, TERMINATED, ARCHIVED
  departmentId    String?
  basicSalary     Float     @default(35000)
  joiningDate     DateTime  @default(now())
  resignationDate DateTime?
  retirementDate  DateTime?
  terminationDate DateTime?
  rejoiningDate   DateTime?
  exitReason      String?
  lifecycleNotes  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  department        Department?             @relation(fields: [departmentId], references: [id])
  leaveRequests     LeaveRequest[]
  salarySlips       StaffSalarySlip[]
  vehicles          Vehicle[]
  staffAttendance   StaffAttendanceRecord[]
  staffAppraisals   StaffAppraisal[]
  salaryHistory     StaffSalaryHistory[]
  lifecycleLogs     StaffLifecycleLog[]
  assignedAssets    AssetItem[]
}

model StaffSalaryHistory {
  id             String   @id @default(cuid())
  teacherId      String?
  staffId        String?
  previousSalary Float
  newSalary      Float
  effectiveDate  DateTime @default(now())
  reason         String?
  revisedBy      String?
  createdAt      DateTime @default(now())

  teacher TeacherProfile? @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  staff   StaffProfile?   @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model StaffLifecycleLog {
  id            String   @id @default(cuid())
  teacherId     String?
  staffId       String?
  employeeCode  String
  action        String   // STATUS_CHANGE, DEPARTMENT_TRANSFER, DESIGNATION_CHANGE, SALARY_REVISION, ASSIGNMENT_ALLOCATED, ASSIGNMENT_REMOVED, REJOINED, EXIT
  previousValue String?
  newValue      String?
  effectiveDate DateTime @default(now())
  remarks       String?
  recordedBy    String?
  createdAt     DateTime @default(now())

  teacher TeacherProfile? @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  staff   StaffProfile?   @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// ENROLLMENT & ATTENDANCE
// -------------------------------------------------------------

model StudentEnrollment {
  id                String   @id @default(cuid())
  studentId         String
  academicYearId    String
  classId           String
  sectionId         String
  rollNumber        String?
  status            String   @default("ACTIVE")
  promotedToYearId  String?
  promotedToClassId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id])
  class        Class          @relation(fields: [classId], references: [id])
  section      Section        @relation(fields: [sectionId], references: [id])
}

model AttendanceRecord {
  id             String   @id @default(cuid())
  studentId      String
  academicYearId String
  sectionId      String
  date           DateTime
  status         String   @default("PRESENT")
  remarks        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id])
  section      Section        @relation(fields: [sectionId], references: [id])
}

// -------------------------------------------------------------
// MODULE A & D: ACADEMIC INTELLIGENCE, LESSON PLANNING & SYLLABUS
// -------------------------------------------------------------

model LessonPlan {
  id                 String    @id @default(cuid())
  teacherId          String
  classId            String
  sectionId          String
  subjectId          String
  chapterId          String?
  topicTitle         String
  learningObjectives String
  teachingMethod     String    @default("Interactive Lecture & Practical Demo")
  materialsNeeded    String?
  scheduledDate      DateTime
  completionStatus   String    @default("PLANNED") // PLANNED, IN_PROGRESS, COMPLETED
  status             String    @default("SUBMITTED") // DRAFT, SUBMITTED, APPROVED, REJECTED
  principalRemarks   String?
  approvedById       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class   Class          @relation(fields: [classId], references: [id])
  section Section        @relation(fields: [sectionId], references: [id])
  subject Subject        @relation(fields: [subjectId], references: [id])
  chapter Chapter?       @relation(fields: [chapterId], references: [id])
}

model AcademicAlert {
  id                String   @id @default(cuid())
  studentId         String
  subjectId         String?
  alertType         String   @default("NEEDS_IMPROVEMENT") // CRITICAL_RISK, NEEDS_IMPROVEMENT, ATTENDANCE_CORRELATED
  metricName        String   @default("Exam Aggregate")
  currentValue      String   @default("42%")
  thresholdValue    String   @default("60%")
  reason            String
  recommendedAction String
  status            String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  detectedDate      DateTime @default(now())

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// MODULE B: AI PERSONALIZED LEARNING
// -------------------------------------------------------------

model LearningPath {
  id                    String   @id @default(cuid())
  studentId             String
  subjectId             String
  targetGoal            String   @default("Score 90%+ in Board Exams")
  currentMastery        Float    @default(55.0)
  recommendedTopicsJson String?  // JSON array of topics
  status                String   @default("ACTIVE")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject        @relation(fields: [subjectId], references: [id])
}

model RevisionSchedule {
  id           String   @id @default(cuid())
  studentId    String
  subjectId    String
  topicName    String
  revisionDate DateTime
  priority     String   @default("NORMAL") // HIGH, MEDIUM, NORMAL
  isCompleted  Boolean  @default(false)
  createdAt    DateTime @default(now())

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject        @relation(fields: [subjectId], references: [id])
}

// -------------------------------------------------------------
// MODULE C: QUESTION BANK & MOCK EXAMINATIONS
// -------------------------------------------------------------

model Question {
  id           String   @id @default(cuid())
  subjectId    String
  chapterId    String?
  questionType String   @default("MCQ") // MCQ, SHORT, LONG, DESCRIPTIVE
  difficulty   String   @default("MEDIUM") // EASY, MEDIUM, HARD
  marks        Int      @default(1)
  questionText String
  explanation  String?
  sampleAnswer String?
  isApproved   Boolean  @default(true)
  createdById  String?
  createdAt    DateTime @default(now())

  subject Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapter Chapter?         @relation(fields: [chapterId], references: [id])
  options QuestionOption[]
}

model QuestionOption {
  id         String  @id @default(cuid())
  questionId String
  optionKey  String  // A, B, C, D
  optionText String
  isCorrect  Boolean @default(false)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuestionPaper {
  id              String   @id @default(cuid())
  title           String
  subjectId       String
  classId         String
  totalMarks      Int      @default(80)
  durationMinutes Int      @default(180)
  instructions    String?
  blueprintJson   String?
  generatedById   String?
  isApproved      Boolean  @default(false)
  approvedById    String?
  createdAt       DateTime @default(now())

  subject Subject @relation(fields: [subjectId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])
}

model MockTest {
  id              String    @id @default(cuid())
  title           String
  subjectId       String
  classId         String
  totalMarks      Int       @default(50)
  durationMinutes Int       @default(60)
  startTime       DateTime?
  endTime         DateTime?
  isPublished     Boolean   @default(false)
  createdAt       DateTime  @default(now())

  subject     Subject              @relation(fields: [subjectId], references: [id])
  class       Class                @relation(fields: [classId], references: [id])
  submissions MockTestSubmission[]
}

model MockTestSubmission {
  id          String   @id @default(cuid())
  mockTestId  String
  studentId   String
  totalScore  Float    @default(0)
  answersJson String?
  submittedAt DateTime @default(now())

  mockTest MockTest       @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  student  StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// MODULE E: SMART CAMPUS SAFETY & VISITOR PASS
// -------------------------------------------------------------

model GateLog {
  id             String    @id @default(cuid())
  personType     String    @default("STUDENT") // STUDENT, STAFF, VISITOR
  personId       String?
  personName     String
  identifierCard String
  entryTime      DateTime  @default(now())
  exitTime       DateTime?
  gateNumber     String    @default("Gate 1 (Main Gate)")
  verifiedBy     String    @default("Security Staff")
  status         String    @default("INSIDE") // INSIDE, EXITED
  user           User?     @relation(fields: [personId], references: [id])
}

model AuthorizedPickup {
  id           String   @id @default(cuid())
  studentId    String
  guardianName String
  relationship String
  phone        String
  photoUrl     String?
  idProofType  String   @default("Aadhaar Card")
  isApproved   Boolean  @default(true)
  createdAt    DateTime @default(now())

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model VisitorPass {
  id           String    @id @default(cuid())
  passNumber   String    @unique
  visitorName  String
  phone        String
  purpose      String
  hostStaffName String   @default("School Principal / Admin")
  checkInTime  DateTime  @default(now())
  checkOutTime DateTime?
  status       String    @default("ACTIVE") // PENDING, ACTIVE, EXPIRED
  badgeQr      String?
}

model SafetyIncident {
  id              String   @id @default(cuid())
  title           String
  severity        String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  category        String   @default("GENERAL") // PLAYGROUND, DISCIPLINE, MEDICAL, PROPERTY
  description     String
  location        String   @default("School Campus")
  reportedById    String?
  status          String   @default("OPEN") // OPEN, INVESTIGATING, RESOLVED
  resolutionNotes String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  reportedBy User? @relation(fields: [reportedById], references: [id])
}

// -------------------------------------------------------------
// MODULE G: HEALTH & CLINIC
// -------------------------------------------------------------

model StudentHealthProfile {
  id                    String    @id @default(cuid())
  studentId             String    @unique
  bloodGroup            String    @default("O+")
  heightCm              Float     @default(155.0)
  weightKg              Float     @default(48.0)
  visionLeft            String?   @default("6/6")
  visionRight           String?   @default("6/6")
  allergies             String?
  chronicConditions     String?
  emergencyMedicalNotes String?
  lastCheckupDate       DateTime?
  updatedAt             DateTime  @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model ClinicVisit {
  id                   String   @id @default(cuid())
  studentId            String?
  staffId              String?
  visitDate            DateTime @default(now())
  symptoms             String
  treatmentGiven       String
  medicineAdministered String?
  referredToHospital   Boolean  @default(false)
  attendedByNurse      String   @default("Nurse Preeti (Campus Health Centre)")

  student StudentProfile? @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model HealthCheckupSchedule {
  id            String   @id @default(cuid())
  title         String
  targetClassId String?
  scheduledDate DateTime
  doctorName    String   @default("Dr. S. K. Joshi (Visiting Paediatrician)")
  checkupType   String   @default("General Physical & Vision Screening")
  status        String   @default("SCHEDULED") // SCHEDULED, COMPLETED
}

// -------------------------------------------------------------
// MODULE H: ADMISSION CRM EXTENSIONS
// -------------------------------------------------------------

model AdmissionApplication {
  id               String    @id @default(cuid())
  applicationNo    String    @unique
  studentName      String
  gender           String    @default("MALE")
  dob              DateTime
  applyingForClass String    @default("Class 10")
  parentName       String
  parentEmail      String
  parentPhone      String
  address          String?
  status           String    @default("ENQUIRY") // ENQUIRY, UNDER_REVIEW, APPROVED, ADMITTED, REJECTED
  interviewDate    DateTime?
  interviewNotes   String?
  createdStudentId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  documents  AdmissionDocument[]
  interviews AdmissionInterview[]
}

model AdmissionDocument {
  id            String   @id @default(cuid())
  applicationId String
  documentType  String   // BIRTH_CERTIFICATE, TRANSFER_CERTIFICATE, REPORT_CARD, ADDRESS_PROOF
  fileUrl       String
  status        String   @default("PENDING") // PENDING, VERIFIED, REJECTED
  verifiedBy    String?
  notes         String?
  createdAt     DateTime @default(now())

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model AdmissionInterview {
  id                 String    @id @default(cuid())
  applicationId      String
  scheduledAt        DateTime
  interviewerName    String    @default("Admissions Committee")
  score              Float?
  feedback           String?
  outcome            String    @default("PENDING") // PENDING, RECOMMENDED, WAITLIST, NOT_RECOMMENDED
  createdAt          DateTime  @default(now())

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

