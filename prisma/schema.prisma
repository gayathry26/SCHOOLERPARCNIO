model NotificationTemplate {
  id             String @id @default(cuid())
  templateKey    String @unique
  titleTemplate  String
  bodyTemplate   String
  defaultChannel String @default("IN_APP") // IN_APP, EMAIL, SMS, WHATSAPP
}

model NotificationDeliveryLog {
  id               String   @id @default(cuid())
  userId           String
  notificationType String   @default("GENERAL")
  channel          String   @default("IN_APP") // IN_APP, EMAIL, SMS, WHATSAPP
  recipientAddress String
  messageBody      String
  status           String   @default("DELIVERED") // SENT, DELIVERED, FAILED
  deliveredAt      DateTime @default(now())
}

// -------------------------------------------------------------
// FEES & FINANCE
// -------------------------------------------------------------

model FeeCategory {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  feeItems FeeItem[]
}

model FeeStructure {
  id             String   @id @default(cuid())
  schoolId       String?  @default("edvonest-main-school")
  title          String
  classId        String?
  academicYearId String?
  frequency      String   @default("Quarterly")
  dueDateDays    Int      @default(10)
  lateFeePerDay  Float    @default(50)
  graceDays      Int      @default(7)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school       School?              @relation(fields: [schoolId], references: [id])
  class        Class?               @relation(fields: [classId], references: [id])
  academicYear AcademicYear?        @relation(fields: [academicYearId], references: [id])
  items        FeeItem[]
  installments FeeInstallmentPlan[]
}

model FeeInstallmentPlan {
  id             String   @id @default(cuid())
  feeStructureId String
  title          String   // e.g. "Term 1 - Admission & Tuition", "Term 2 - Mid Term"
  dueDate        DateTime
  percentage     Float    @default(25.0)
  amount         Float    @default(0)
  order          Int      @default(1)
  createdAt      DateTime @default(now())

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
}

model FeeItem {
  id             String @id @default(cuid())
  feeStructureId String
  categoryId     String
  amount         Float

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  category     FeeCategory  @relation(fields: [categoryId], references: [id])
}

model StudentFeeConcession {
  id             String   @id @default(cuid())
  schoolId       String?  @default("edvonest-main-school")
  studentId      String
  concessionType String   @default("SCHOLARSHIP") // SCHOLARSHIP, SIBLING_DISCOUNT, MERIT, EWS, STAFF_WARD, SPECIAL
  discountType   String   @default("PERCENTAGE") // PERCENTAGE, FLAT
  discountValue  Float    @default(0)
  reason         String?
  approvedBy     String?
  academicYearId String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model StudentFeeInvoice {
  id               String   @id @default(cuid())
  schoolId         String?  @default("edvonest-main-school")
  invoiceNumber    String   @unique
  studentId        String
  academicYearId   String?
  title            String
  totalAmount      Float
  concessionAmount Float    @default(0)
  lateFeeAmount    Float    @default(0)
  paidAmount       Float    @default(0)
  status           String   @default("PENDING") // PENDING, PARTIALLY_PAID, PAID, OVERDUE, CANCELLED
  dueDate          DateTime
  graceDate        DateTime?
  idempotencyKey   String?  @unique
  itemsJson        String?  // JSON snapshot of fee item lines & concessions applied
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  student   StudentProfile      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments  FeePaymentReceipt[]
  reminders FeeReminderLog[]
}

model FeePaymentReceipt {
  id                String   @id @default(cuid())
  schoolId          String?  @default("edvonest-main-school")
  receiptNumber     String   @unique
  invoiceId         String
  bankAccountId     String?
  amountPaid        Float
  paymentMode       String   @default("UPI") // UPI, CARD, NET_BANKING, CASH, CHEQUE, RAZORPAY
  transactionRef    String?
  chequeNumber      String?
  chequeDate        DateTime?
  bankName          String?
  upiId             String?
  gatewayReference  String?
  razorpayPaymentId String?
  razorpayOrderId   String?
  status            String   @default("SUCCESS") // SUCCESS, REFUNDED, PARTIALLY_REFUNDED, BOUNCED, CANCELLED
  refundedAmount    Float    @default(0)
  collectedBy       String?
  notes             String?
  idempotencyKey    String?  @unique
  paidAt            DateTime @default(now())

  invoice     StudentFeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  bankAccount BankAccount?      @relation(fields: [bankAccountId], references: [id])
  refunds     PaymentRefund[]
}

model PaymentRefund {
  id             String   @id @default(cuid())
  schoolId       String?  @default("edvonest-main-school")
  receiptId      String
  refundNumber   String   @unique
  amount         Float
  refundMode     String   @default("BANK_TRANSFER") // CASH, BANK_TRANSFER, UPI, ORIGINAL_SOURCE
  reason         String
  processedBy    String
  approvedBy     String?
  status         String   @default("COMPLETED") // COMPLETED, PENDING, REJECTED
  transactionRef String?
  createdAt      DateTime @default(now())

  receipt FeePaymentReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

model BankAccount {
  id             String   @id @default(cuid())
  schoolId       String?  @default("edvonest-main-school")
  accountName    String   // e.g. "Main Operating Account", "SBI Fees Account", "Cash Counter Box"
  accountType    String   @default("BANK") // BANK, CASH, PETTY_CASH
  bankName       String?  // e.g. "State Bank of India", "HDFC Bank"
  accountNumber  String?
  ifscCode       String?
  branch         String?
  currentBalance Float    @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  receipts        FeePaymentReceipt[]
  ledgerEntries   FinancialLedgerEntry[]
  reconciliations ReconciliationLog[]
}

model FinancialLedgerEntry {
  id              String   @id @default(cuid())
  schoolId        String?  @default("edvonest-main-school")
  entryNumber     String   @unique
  entryType       String   // INCOME, EXPENSE
  categoryName    String   // Tuition Fee, Transport Fee, Salary, Lab Equipment, Utility
  amount          Float
  paymentMode     String   @default("BANK_TRANSFER")
  bankAccountId   String?
  referenceType   String?  // FEE_PAYMENT, REFUND, VENDOR_PAYMENT, ASSET_PURCHASE
  referenceId     String?
  description     String
  transactionDate DateTime @default(now())
  createdById     String?
  createdAt       DateTime @default(now())

  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id])
}

model ReconciliationLog {
  id                 String   @id @default(cuid())
  schoolId           String?  @default("edvonest-main-school")
  bankAccountId      String
  statementDate      DateTime
  openingBalance     Float
  closingBalance     Float
  reconciledAmount   Float
  unreconciledAmount Float    @default(0)
  matchedCount       Int      @default(0)
  status             String   @default("MATCHED") // MATCHED, DISCREPANCY, DRAFT
  reconciledBy       String
  notes              String?
  createdAt          DateTime @default(now())

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
}

model FeeReminderLog {
  id        String   @id @default(cuid())
  schoolId  String?  @default("edvonest-main-school")
  studentId String
  invoiceId String
  channel   String   @default("IN_APP") // IN_APP, SMS, WHATSAPP, EMAIL
  recipient String   // phone or email or guardian name
  message   String
  sentAt    DateTime @default(now())
  status    String   @default("DELIVERED") // DELIVERED, FAILED

  student StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  invoice StudentFeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model ExpenseCategory {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  vouchers ExpenseVoucher[]
}

model ExpenseVoucher {
  id            String   @id @default(cuid())
  schoolId      String?  @default("edvonest-main-school")
  voucherNumber String   @unique
  categoryId    String
  title         String
  vendorName    String?
  vendorPhone   String?
  vendorInvoice String?
  amount        Float
  paymentMode   String   @default("BANK_TRANSFER")
  bankAccountId String?
  status        String   @default("PAID") // PAID, PENDING, CANCELLED
  approvedBy    String?
  notes         String?
  expenseDate   DateTime @default(now())
  createdAt     DateTime @default(now())

  category ExpenseCategory @relation(fields: [categoryId], references: [id])
}

// -------------------------------------------------------------
// EXAMINATIONS (TRADITIONAL)
// -------------------------------------------------------------

model Exam {
  id             String    @id @default(cuid())
  name           String
  term           String    @default("TERM 1")
  academicYearId String?
  startDate      DateTime
  endDate        DateTime
  isLocked       Boolean   @default(false)
  lockedAt       DateTime?
  lockedBy       String?
  isPublished    Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  academicYear AcademicYear?  @relation(fields: [academicYearId], references: [id])
  schedules    ExamSchedule[]
}

model ExamSchedule {
  id        String   @id @default(cuid())
  examId    String
  subjectId String
  examDate  DateTime
  maxMarks  Float    @default(100)
  passMarks Float    @default(33)

  exam        Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject     Subject         @relation(fields: [subjectId], references: [id])
  markEntries ExamMarkEntry[]
}

model ExamMarkEntry {
  id             String   @id @default(cuid())
  examScheduleId String
  studentId      String
  theoryMarks    Float    @default(0)
  practicalMarks Float    @default(0)
  graceMarks     Float    @default(0)
  isAbsent       Boolean  @default(false)
  remarks        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  examSchedule ExamSchedule   @relation(fields: [examScheduleId], references: [id], onDelete: Cascade)
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// TIMETABLE & HOMEWORK
// -------------------------------------------------------------

model TimetableEntry {
  id             String   @id @default(cuid())
  academicYearId String
  sectionId      String
  subjectId      String
  teacherId      String
  dayOfWeek      String
  periodIndex    Int
  startTime      String   @default("08:30")
  endTime        String   @default("09:15")
  roomNumber     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id])
  section      Section        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject      Subject        @relation(fields: [subjectId], references: [id])
  teacher      TeacherProfile @relation(fields: [teacherId], references: [id])
}

model Homework {
  id          String   @id @default(cuid())
  classId     String
  sectionId   String
  subjectId   String
  title       String
  description String
  dueDate     DateTime
  maxMarks    Int      @default(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  class       Class                @relation(fields: [classId], references: [id])
  section     Section              @relation(fields: [sectionId], references: [id])
  subject     Subject              @relation(fields: [subjectId], references: [id])
  submissions HomeworkSubmission[]
}

model HomeworkSubmission {
  id             String   @id @default(cuid())
  homeworkId     String
  studentId      String
  submissionText String?
  marksAwarded   Float?
  feedback       String?
  status         String   @default("SUBMITTED")
  submittedDate  DateTime @default(now())

  homework Homework       @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student  StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model StudyMaterial {
  id          String   @id @default(cuid())
  subjectId   String
  title       String
  description String?
  fileUrl     String?
  fileType    String?  @default("PDF")
  createdAt   DateTime @default(now())

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// LIBRARY MANAGEMENT
// -------------------------------------------------------------

model LibraryBook {
  id              String   @id @default(cuid())
  title           String
  author          String
  isbn            String   @unique
  category        String   @default("Science")
  rackNumber      String?  @default("RACK-01")
  totalCopies     Int      @default(5)
  availableCopies Int      @default(5)
  price           Float    @default(350)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  issues BookIssueRecord[]
}

model BookIssueRecord {
  id         String    @id @default(cuid())
  bookId     String
  studentId  String
  issueDate  DateTime  @default(now())
  dueDate    DateTime
  returnDate DateTime?
  status     String    @default("ISSUED")
  fineAmount Float     @default(0)
  createdAt  DateTime  @default(now())

  book    LibraryBook    @relation(fields: [bookId], references: [id])
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// TRANSPORT INTELLIGENCE & FLEET
// -------------------------------------------------------------

model Vehicle {
  id              String   @id @default(cuid())
  vehicleNumber   String   @unique
  model           String   @default("Tata Starbus 40-Seater")
  seatingCapacity Int      @default(40)
  driverStaffId   String?
  gpsDeviceId     String?  @default("GPS-EDV-4421")
  createdAt       DateTime @default(now())

  driverStaff        StaffProfile?        @relation(fields: [driverStaffId], references: [id])
  routes             Route[]
  busTrips           BusTripLog[]
  maintenanceRecords VehicleMaintenance[]
}

model Route {
  id              String   @id @default(cuid())
  routeName       String
  startPoint      String   @default("Campus Sector 62")
  endPoint        String   @default("Sector 128")
  totalDistanceKm Float    @default(18.5)
  vehicleId       String?
  createdAt       DateTime @default(now())

  vehicle     Vehicle?                     @relation(fields: [vehicleId], references: [id])
  stops       RouteStop[]
  assignments StudentTransportAssignment[]
  busTrips    BusTripLog[]
}

model RouteStop {
  id         String @id @default(cuid())
  routeId    String
  stopName   String
  stopOrder  Int
  pickupTime String @default("07:20 AM")
  dropTime   String @default("02:45 PM")
  monthlyFee Float  @default(1800)

  route       Route                        @relation(fields: [routeId], references: [id], onDelete: Cascade)
  assignments StudentTransportAssignment[]
}

model StudentTransportAssignment {
  id        String   @id @default(cuid())
  studentId String   @unique
  routeId   String
  stopId    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  route   Route          @relation(fields: [routeId], references: [id])
  stop    RouteStop      @relation(fields: [stopId], references: [id])
}

model BusTripLog {
  id             String    @id @default(cuid())
  vehicleId      String
  routeId        String
  tripType       String    @default("MORNING_PICKUP") // MORNING_PICKUP, AFTERNOON_DROP
  driverName     String    @default("Harpal Singh")
  startTime      DateTime  @default(now())
  endTime        DateTime?
  currentLat     Float?    @default(28.6280)
  currentLng     Float?    @default(77.3649)
  currentSpeedKm Float?    @default(38.5)
  status         String    @default("IN_TRANSIT") // SCHEDULED, IN_TRANSIT, COMPLETED, DELAYED
  deviationAlert Boolean   @default(false)
  etaMinutes     Int?      @default(12)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  route   Route   @relation(fields: [routeId], references: [id])
}

model VehicleMaintenance {
  id              String    @id @default(cuid())
  vehicleId       String
  maintenanceType String    // SERVICE, POLLUTION_CHECK, INSURANCE_RENEWAL, FITNESS_CERT
  scheduledDate   DateTime
  completedDate   DateTime?
  cost            Float     @default(4500)
  vendorName      String?   @default("Tata Authorized Service Centre")
  status          String    @default("COMPLETED") // PENDING, COMPLETED, OVERDUE

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// HR, LEAVES & SALARY
// -------------------------------------------------------------

model LeaveRequest {
  id            String   @id @default(cuid())
  teacherId     String?
  staffId       String?
  leaveType     String   @default("CASUAL")
  startDate     DateTime
  endDate       DateTime
  daysCount     Int      @default(1)
  reason        String
  status        String   @default("PENDING")
  approvedBy    String?
  actionRemarks String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  teacher TeacherProfile? @relation(fields: [teacherId], references: [id])
  staff   StaffProfile?   @relation(fields: [staffId], references: [id])
}

model StaffSalarySlip {
  id          String   @id @default(cuid())
  slipNumber  String   @unique
  teacherId   String?
  staffId     String?
  month       String
  basicSalary Float
  allowances  Float    @default(5000)
  deductions  Float    @default(2000)
  netSalary   Float
  status      String   @default("PAID")
  paymentDate DateTime @default(now())
  createdAt   DateTime @default(now())

  teacher TeacherProfile? @relation(fields: [teacherId], references: [id])
  staff   StaffProfile?   @relation(fields: [staffId], references: [id])
}

// -------------------------------------------------------------
// COMMUNICATION, ANNOUNCEMENTS, MESSAGES & NOTIFICATIONS
// -------------------------------------------------------------

model Announcement {
  id             String   @id @default(cuid())
  schoolId       String   @default("EDVONEST-DEL-01")
  title          String
  content        String
  targetAudience String   @default("ALL")
  priority       String   @default("NORMAL")
  authorName     String
  publishedAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  school School? @relation(fields: [schoolId], references: [id])
}

model DirectMessage {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  studentId  String?
  message    String
  sentAt     DateTime @default(now())
  isRead     Boolean  @default(false)

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("GENERAL")
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// CERTIFICATES & CMS
// -------------------------------------------------------------

model CertificateTemplate {
  id           String   @id @default(cuid())
  name         String
  type         String
  bodyTemplate String
  createdAt    DateTime @default(now())

  certificates IssuedCertificate[]
}

model IssuedCertificate {
  id              String   @id @default(cuid())
  certificateNo   String   @unique
  templateId      String?
  studentId       String
  certificateType String
  purpose         String
  generatedBy     String
  issueDate       DateTime @default(now())
  createdAt       DateTime @default(now())

  template CertificateTemplate? @relation(fields: [templateId], references: [id])
  student  StudentProfile       @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model SchoolEvent {
  id                String              @id @default(cuid())
  title             String
  description       String?
  startDate         DateTime
  endDate           DateTime?
  venue             String?             @default("School Auditorium")
  category          String              @default("EVENT")
  classId           String?
  sectionId         String?
  targetRole        String              @default("ALL")
  isRecurring       Boolean             @default(false)
  recurrencePattern String?
  reminderMinutes   Int                 @default(30)
  color             String?
  schoolId          String?
  createdAt         DateTime            @default(now())

  school       School?             @relation(fields: [schoolId], references: [id])
  participants EventRegistration[]
  gallery      EventGalleryItem[]
}

model CmsPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String
  schoolId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School? @relation(fields: [schoolId], references: [id])
}

model AuditLog {
  id            String   @id @default(cuid())
  schoolId      String?
  userId        String?
  action        String
  module        String
  recordId      String?
  previousValue String?
  newValue      String?
  ipAddress     String?
  timestamp     DateTime @default(now())

  school School? @relation(fields: [schoolId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])
}

// -------------------------------------------------------------
// MODULE: ACADEMIC YEAR & SCHOOL LIFECYCLE MANAGEMENT
// -------------------------------------------------------------

model TeacherAllocation {
  id             String   @id @default(cuid())
  academicYearId String
  teacherId      String
  classId        String
  sectionId      String
  subjectId      String?
  role           String   @default("SUBJECT_TEACHER") // CLASS_TEACHER, SUBJECT_TEACHER, CO_TEACHER
  periodsPerWeek Int      @default(5)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  teacher      TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class        Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  section      Section        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject      Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
}

model StudentPromotionLog {
  id                String   @id @default(cuid())
  studentId         String
  fromYearId        String
  toYearId          String
  fromClassId       String
  toClassId         String
  fromSectionId     String
  toSectionId       String
  status            String   @default("PROMOTED") // PROMOTED, DETAINED, CONDITIONAL, GRADUATED
  eligibilityNotes  String?
  attendancePercent Float?
  marksPercent      Float?
  processedById     String?
  createdAt         DateTime @default(now())

  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromYear  AcademicYear   @relation("FromYear", fields: [fromYearId], references: [id])
  toYear    AcademicYear   @relation("ToYear", fields: [toYearId], references: [id])
  fromClass Class          @relation("FromClass", fields: [fromClassId], references: [id])
  toClass   Class          @relation("ToClass", fields: [toClassId], references: [id])
}

model SectionTransferLog {
  id             String   @id @default(cuid())
  studentId      String
  academicYearId String
  fromSectionId  String
  toSectionId    String
  reason         String?
  transferredById String?
  transferredAt  DateTime @default(now())

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model AlumniRecord {
  id                  String   @id @default(cuid())
  studentId           String   @unique
  graduationYear      String
  finalClass          String   @default("Class 12")
  passingMarksPercent Float?
  conduct             String   @default("EXCELLENT")
  currentPursuit      String?
  contactEmail        String?
  contactPhone        String?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model YearEndClosingLog {
  id                String   @id @default(cuid())
  academicYearId    String
  closedAt          DateTime @default(now())
  closedById        String?
  totalStudents     Int      @default(0)
  promotedCount     Int      @default(0)
  detainedCount     Int      @default(0)
  graduatedCount    Int      @default(0)
  unpaidFeeInvoices Int      @default(0)
  totalPendingFees  Float    @default(0)
  allExamsLocked    Boolean  @default(true)
  summaryNotes      String?

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
}

// -------------------------------------------------------------
// MODULE: SAAS MULTI-TENANT SUBSCRIPTION & BILLING
// -------------------------------------------------------------

model SubscriptionPlan {
  id              String   @id @default(cuid())
  code            String   @unique // FREE_TRIAL, BASIC, STANDARD, PREMIUM, ENTERPRISE
  name            String
  description     String?
  pricePerYear    Float    @default(0)
  pricePerMonth   Float    @default(0)
  maxStudents     Int      @default(500)
  maxStaff        Int      @default(50)
  allowedModules  String   @default("ALL")
  features        String?
  isPopular       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SubscriptionInvoice {
  id             String    @id @default(cuid())
  invoiceNumber  String    @unique
  schoolId       String
  planCode       String
  amount         Float
  currency       String    @default("INR")
  status         String    @default("PAID") // PAID, PENDING, OVERDUE, VOID
  billingPeriod  String
  dueDate        DateTime
  paidAt         DateTime?
  paymentMethod  String?   @default("BANK_TRANSFER")
  transactionRef String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}
