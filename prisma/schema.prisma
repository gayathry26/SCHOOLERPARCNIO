// -------------------------------------------------------------
// MODULE J: PARENT PORTAL (PTM & DIGITAL CONSENT)
// -------------------------------------------------------------

model PtmEvent {
  id                        String      @id @default(cuid())
  schoolId                  String?     @default("edvonest-main-school")
  title                     String
  description               String?
  academicYearId            String?
  eventDate                 DateTime
  startTime                 String      @default("09:00 AM")
  endTime                   String      @default("02:00 PM")
  slotDuration              Int         @default(15) // minutes
  bufferTime                Int         @default(5)  // minutes
  targetClassIds            String?     // e.g. comma-separated class IDs or "ALL"
  status                    String      @default("OPEN_FOR_BOOKING") // DRAFT, OPEN_FOR_BOOKING, IN_PROGRESS, COMPLETED, ARCHIVED
  meetingMode               String      @default("HYBRID") // IN_PERSON, ONLINE_VIDEO, HYBRID
  locationRoom              String?     @default("Main Campus Academic Block")
  defaultMeetingLink        String?
  allowSubjectTeacherChoice Boolean     @default(true)
  bookingDeadline           DateTime?
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @default(now()) @updatedAt

  slots    PtmSlot[]
  bookings PtmBooking[]
}

model PtmSlot {
  id          String   @id @default(cuid())
  ptmEventId  String?
  teacherId   String
  slotDate    DateTime
  startTime   String   // e.g. "09:30 AM"
  endTime     String   // e.g. "09:45 AM"
  meetingMode String   @default("IN_PERSON") // IN_PERSON, ONLINE_VIDEO
  roomNumber  String?  @default("Room 204")
  meetingLink String?
  isBooked    Boolean  @default(false)
  isBlocked   Boolean  @default(false)
  blockReason String?
  createdAt   DateTime @default(now())

  ptmEvent PtmEvent?       @relation(fields: [ptmEventId], references: [id], onDelete: Cascade)
  teacher  TeacherProfile  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  booking  PtmBooking?
}

model PtmBooking {
  id                   String    @id @default(cuid())
  ptmEventId           String?
  slotId               String?   @unique
  parentId             String
  studentId            String?
  teacherId            String
  scheduledDate        DateTime
  timeSlot             String    @default("10:00 AM - 10:20 AM")
  meetingMode          String    @default("IN_PERSON") // IN_PERSON, ONLINE_VIDEO
  roomNumber           String?
  meetingLink          String?
  notes                String?   // Initial parent agenda / inquiry
  sharedNotes          String?   // Parent-visible meeting notes & feedback
  privateTeacherNotes  String?   // 🔒 Strictly private teacher/principal observations (never exposed to parents)
  notesRecordedAt      DateTime?
  notesRecordedByName  String?
  status               String    @default("CONFIRMED") // CONFIRMED, RESCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED, NO_SHOW
  cancellationReason   String?
  rescheduledFromTime  String?
  reminderSent         Boolean   @default(false)
  reminderSentAt       DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt

  ptmEvent   PtmEvent?          @relation(fields: [ptmEventId], references: [id])
  slot       PtmSlot?           @relation(fields: [slotId], references: [id])
  parent     ParentProfile      @relation(fields: [parentId], references: [id], onDelete: Cascade)
  teacher    TeacherProfile     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student    StudentProfile?    @relation(fields: [studentId], references: [id])
  followUps  PtmFollowUpTask[]
}

model PtmFollowUpTask {
  id          String    @id @default(cuid())
  bookingId   String
  title       String
  assignedTo  String    @default("PARENT") // PARENT, TEACHER, STUDENT
  status      String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  dueDate     DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  booking PtmBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model DigitalConsent {
  id          String    @id @default(cuid())
  parentId    String
  studentId   String
  title       String
  description String
  deadline    DateTime
  isAccepted  Boolean?
  signedAt    DateTime?
  createdAt   DateTime  @default(now())

  parent  ParentProfile  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// -------------------------------------------------------------
// MODULE K: INVENTORY, PROCUREMENT & ASSET MANAGEMENT
// -------------------------------------------------------------

model AssetCategory {
  id          String      @id @default(cuid())
  name        String      // Books, Uniforms, Stationery, Computers, Laboratory equipment, Sports equipment, Furniture, Electrical equipment, Cleaning materials, Office supplies, School assets
  code        String      @unique
  description String?
  isAsset     Boolean     @default(true) // true = Capital Asset, false = Consumable Inventory
  createdAt   DateTime    @default(now())
  assets      AssetItem[]
}

model AssetItem {
  id                  String    @id @default(cuid())
  assetCode           String    @unique
  barcode             String?   @unique
  qrCode              String?
  name                String
  categoryId          String
  location            String    @default("Main Campus Store")
  unit                String    @default("PIECES") // PIECES, BOXES, SETS, PACKETS, KGS, LITERS, REAMS, PAIRS, METERS
  vendorId            String?
  purchaseDate        DateTime  @default(now())
  purchaseCost        Float     @default(5000)
  unitPrice           Float     @default(0)
  currentQuantity     Int       @default(1)
  minStockThreshold   Int       @default(2)
  maxStockThreshold   Int       @default(100)
  reorderLevel        Int       @default(5)
  condition           String    @default("EXCELLENT") // NEW, EXCELLENT, GOOD, FAIR, NEEDS_REPAIR, DAMAGED, DISPOSED
  isConsumable        Boolean   @default(false)
  warrantyExpiry      DateTime?
  amcDetails          String?
  serialNumber        String?
  assignedDepartmentId String?
  assignedStaffId     String?
  depreciationRate    Float     @default(10.0)
  disposalDate        DateTime?
  disposalMethod      String?   // SCRAPPED, SOLD, DONATED, E_WASTE
  disposalValue       Float?
  disposalReason      String?
  schoolId            String?   @default("edvonest-main-school")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  category            AssetCategory         @relation(fields: [categoryId], references: [id])
  vendor              AssetVendor?          @relation(fields: [vendorId], references: [id])
  assignedDepartment  Department?           @relation(fields: [assignedDepartmentId], references: [id])
  assignedStaff       StaffProfile?         @relation(fields: [assignedStaffId], references: [id])
  issues              AssetIssueRecord[]
  movements           StockMovement[]
  maintenanceLogs     AssetMaintenanceLog[]
  auditItems          StockAuditItem[]
  poItems             PurchaseOrderItem[]
}

model AssetVendor {
  id            String   @id @default(cuid())
  name          String
  vendorCode    String?  @unique
  contactPerson String?
  phone         String
  email         String?
  address       String?
  gstNumber     String?
  category      String?  @default("General Supplies") // Books, Stationery, Lab, IT, Furniture, Sports, Uniforms
  rating        Float    @default(4.5)
  paymentTerms  String?  @default("Net 30 Days")
  bankDetails   String?
  createdAt     DateTime @default(now())

  assets         AssetItem[]
  purchaseOrders PurchaseOrder[]
}

model AssetIssueRecord {
  id              String    @id @default(cuid())
  assetId         String
  issuedToUserId  String
  issuedDate      DateTime  @default(now())
  returnDueDate   DateTime
  returnDate      DateTime?
  quantity        Int       @default(1)
  conditionReturn String?
  remarks         String?

  asset    AssetItem @relation(fields: [assetId], references: [id], onDelete: Cascade)
  issuedTo User      @relation(fields: [issuedToUserId], references: [id])
}

model StockMovement {
  id               String   @id @default(cuid())
  assetItemId      String
  movementType     String   // STOCK_IN, STOCK_OUT, ADJUSTMENT, ISSUE, RETURN, TRANSFER, DAMAGE, DISPOSAL
  quantity         Int
  previousQuantity Int
  newQuantity      Int
  fromLocation     String?
  toLocation       String?
  referenceNumber  String?  // PO-2026-001, GRN-001, ISSUE-101, ADJ-001
  unitCost         Float    @default(0)
  totalCost        Float    @default(0)
  reason           String?
  recordedBy       String   @default("Store Manager")
  createdAt        DateTime @default(now())

  assetItem AssetItem @relation(fields: [assetItemId], references: [id], onDelete: Cascade)
}

model PurchaseRequest {
  id                String   @id @default(cuid())
  itemTitle         String
  categoryName      String   @default("General Supplies")
  quantity          Int      @default(1)
  estimatedCost     Float    @default(5000)
  requestedByUserId String
  departmentName    String?  @default("Academics")
  priority          String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  reason            String
  status            String   @default("PENDING") // PENDING, DEPARTMENT_APPROVED, APPROVED, REJECTED, ORDERED, FULFILLED
  approvedByUserId  String?
  quotationRef      String?
  quotationVendor   String?
  quotationAmount   Float?
  endorsementNotes  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  requestedBy    User            @relation(fields: [requestedByUserId], references: [id])
  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id                   String    @id @default(cuid())
  poNumber             String    @unique
  purchaseRequestId    String?
  vendorId             String
  schoolId             String?   @default("edvonest-main-school")
  orderDate            DateTime  @default(now())
  expectedDeliveryDate DateTime?
  status               String    @default("ISSUED") // DRAFT, ISSUED, PARTIALLY_DELIVERED, DELIVERED, CANCELLED
  subtotal             Float     @default(0)
  taxAmount            Float     @default(0)
  totalAmount          Float     @default(0)
  paymentTerms         String?   @default("Net 30 Days")
  notes                String?
  createdByName        String    @default("Procurement Officer")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt

  vendor          AssetVendor         @relation(fields: [vendorId], references: [id])
  purchaseRequest PurchaseRequest?    @relation(fields: [purchaseRequestId], references: [id])
  items           PurchaseOrderItem[]
  grns            GoodsReceivedNote[]
}

model PurchaseOrderItem {
  id               String  @id @default(cuid())
  purchaseOrderId  String
  assetItemId      String?
  itemTitle        String
  quantity         Int     @default(1)
  receivedQuantity Int     @default(0)
  unitPrice        Float   @default(0)
  totalPrice       Float   @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  assetItem     AssetItem?    @relation(fields: [assetItemId], references: [id])
}

model GoodsReceivedNote {
  id              String    @id @default(cuid())
  grnNumber       String    @unique
  purchaseOrderId String
  receivedDate    DateTime  @default(now())
  receivedByName  String    @default("Store Keeper")
  invoiceNumber   String?
  invoiceDate     DateTime?
  invoiceAmount   Float?
  paymentStatus   String    @default("UNPAID") // UNPAID, PARTIALLY_PAID, PAID
  paymentMode     String?
  transactionRef  String?
  remarks         String?
  createdAt       DateTime  @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
}

model AssetMaintenanceLog {
  id                String    @id @default(cuid())
  assetItemId       String
  maintenanceType   String    @default("PREVENTIVE") // PREVENTIVE, CORRECTIVE, CALIBRATION, AMC_SERVICE, REPAIR
  serviceDate       DateTime  @default(now())
  serviceProvider   String
  technicianName    String?
  technicianContact String?
  description       String
  cost              Float     @default(0)
  status            String    @default("COMPLETED") // SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED
  nextServiceDate   DateTime?
  recordedByName    String    @default("Admin")
  createdAt         DateTime  @default(now())

  assetItem AssetItem @relation(fields: [assetItemId], references: [id], onDelete: Cascade)
}

model StockAuditSession {
  id             String   @id @default(cuid())
  auditCode      String   @unique
  auditDate      DateTime @default(now())
  auditorName    String   @default("Internal Auditor")
  departmentName String?  @default("All Campus Stores")
  status         String   @default("COMPLETED") // DRAFT, IN_PROGRESS, COMPLETED, RECONCILED
  remarks        String?
  createdAt      DateTime @default(now())

  items StockAuditItem[]
}

model StockAuditItem {
  id               String  @id @default(cuid())
  auditSessionId   String
  assetItemId      String
  systemQuantity   Int
  physicalQuantity Int
  discrepancy      Int     @default(0)
  unitCost         Float   @default(0)
  discrepancyValue Float   @default(0)
  reason           String?
  reconciled       Boolean @default(false)

  auditSession StockAuditSession @relation(fields: [auditSessionId], references: [id], onDelete: Cascade)
  assetItem    AssetItem         @relation(fields: [assetItemId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// MODULE L: ADVANCED HR & FACULTY WORKLOAD
// -------------------------------------------------------------

model StaffAttendanceRecord {
  id               String    @id @default(cuid())
  staffProfileId   String?
  teacherProfileId String?
  date             DateTime
  status           String    @default("PRESENT") // PRESENT, ABSENT, HALF_DAY, ON_DUTY
  checkInTime      String?   @default("08:15 AM")
  checkOutTime     String?   @default("03:30 PM")

  staff   StaffProfile?   @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  teacher TeacherProfile? @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
}

model SubstituteAssignment {
  id                  String   @id @default(cuid())
  absentTeacherId     String
  substituteTeacherId String
  sectionId           String
  periodIndex         Int      @default(1)
  date                DateTime
  status              String   @default("ASSIGNED") // ASSIGNED, ACKNOWLEDGED, COMPLETED
  createdAt           DateTime @default(now())

  absentTeacher     TeacherProfile @relation("AbsentTeacher", fields: [absentTeacherId], references: [id])
  substituteTeacher TeacherProfile @relation("SubTeacher", fields: [substituteTeacherId], references: [id])
  section           Section        @relation(fields: [sectionId], references: [id])
}

model StaffAppraisal {
