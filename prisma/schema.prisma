model EventRegistration {
  id                  String   @id @default(cuid())
  eventId             String
  studentId           String
  roleOrCategory      String?  @default("Participant")
  participationStatus String   @default("REGISTERED") // REGISTERED, SHORTLISTED, WINNER, PARTICIPATED
  parentConsentGiven  Boolean  @default(true)
  registeredAt        DateTime @default(now())

  event   SchoolEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
