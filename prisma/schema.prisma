  administrativeScore  Float?   @default(4.2)
  finalRating          String   @default("OUTSTANDING") // OUTSTANDING, VERY_GOOD, GOOD, SATISFACTORY
  reviewRemarks        String?  @default("Exemplary academic syllabus progression and active mentorship.")
  reviewedByStaff      String   @default("Dr. Sunita Mehra (Principal)")
  createdAt            DateTime @default(now())

  teacher TeacherProfile? @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  staff   StaffProfile?   @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
}

