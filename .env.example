# ==============================================================================
# EDVONEST SCHOOL MANAGEMENT ERP — ENVIRONMENT SPECIFICATION
# Tagline: Learn • Grow • Succeed
# ==============================================================================

# Core Application Settings
NODE_ENV="production" # development | staging | production | test
APP_URL="https://edvonest.your-domain.edu.in"
PORT=3000

# Multi-Tenant Database Connection
# In Development: SQLite ("file:./dev.db")
# In Staging / Production: PostgreSQL with connection pooling
# Example: postgresql://edvonest_user:STRONG_PASSWORD@db-host:5432/edvonest_prod?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://edvonest_admin:CHANGE_ME_PASSWORD@localhost:5432/edvonest_production?sslmode=prefer"

# Cryptographic Keys (Must be minimum 32 characters in production)
JWT_SECRET="edvonest_prod_jwt_secret_must_be_minimum_32_characters_long_2026"
NEXTAUTH_SECRET="edvonest_prod_nextauth_secret_minimum_32_chars_key_2026"

# Automated Database Backup Encryption Key (AES-256-GCM)
# Generate with: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY="edvonest_backup_aes256_super_secure_key_32_bytes!"
BACKUP_STORAGE_PATH="./backups"
BACKUP_RETENTION_DAYS=30

# File Storage Configuration
STORAGE_DRIVER="local" # local | s3 | gcs
STORAGE_LOCAL_DIR="./storage/secure_uploads"
STORAGE_MAX_FILE_SIZE_MB=10

# S3 Configuration (Optional for cloud storage)
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET="edvonest-production-attachments"

# Monitoring & Error Reporting
LOG_LEVEL="info" # debug | info | warn | error
ENABLE_PERFORMANCE_METRICS=true
SENTRY_DSN=""

# Branding Defaults
NEXT_PUBLIC_APP_NAME="EDVONEST"
NEXT_PUBLIC_APP_TAGLINE="Learn • Grow • Succeed"
NEXT_PUBLIC_SCHOOL_NAME="Edvonest Model International Academy"
